{
  "name": "trading-agent",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:data": "cd apps/data-service && .\\venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 8001",
    "docker:up": "docker compose up -d postgres"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  }
}
